AAPDA_SECRET_KEY=replace_with_a_long_random_secret
AAPDA_COOKIE_SECURE=false
AAPDA_VAULT_DB=data/vault.sqlite3

# Create a PRIVATE bucket named below. The service role key is server-only.
AAPDA_SUPABASE_URL=https://your-project.supabase.co
AAPDA_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
AAPDA_SUPABASE_BUCKET=safelife-vault
AAPDA_VAULT_ENCRYPTION_KEY=replace_with_a_fernet_key

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

AAPDA_IMD_FEED_URL=
AAPDA_SACHET_FEED_URL=
AAPDA_CWC_FEED_URL=
AAPDA_INCOIS_FEED_URL=
AAPDA_GSI_FEED_URL=
